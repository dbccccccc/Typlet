{"cat":"realistic","display":true,"id":"schrodinger","src":"i planck partial/(partial t) Psi(bold(r),t) = [-planck^2/(2m) nabla^2 + V(bold(r),t)] Psi(bold(r),t)","tex":"i\\hbar\\frac{\\partial}{\\partial t}\\Psi(\\mathbf{r},t) = \\left[-\\frac{\\hbar^2}{2m}\\nabla^2 + V(\\mathbf{r},t)\\right]\\Psi(\\mathbf{r},t)"}
{"cat":"realistic","display":true,"id":"fourier","src":"hat(f)(xi) = integral_(-infinity)^infinity f(x) e^(-2 pi i x xi) dif x","tex":"\\hat{f}(\\xi) = \\int_{-\\infty}^{\\infty} f(x)\\, e^{-2\\pi i x \\xi}\\,dx"}
{"cat":"realistic","display":true,"id":"bayes","src":"P(A mid(|) B) = (P(B mid(|) A) P(A))/P(B)","tex":"P(A\\mid B)=\\frac{P(B\\mid A)\\,P(A)}{P(B)}"}
{"cat":"realistic","display":true,"id":"einstein","src":"R_(mu nu) - inline(1/2) R g_(mu nu) + Lambda g_(mu nu) = (8 pi G)/c^4 T_(mu nu)","tex":"R_{\\mu\\nu}-\\tfrac{1}{2}Rg_{\\mu\\nu}+\\Lambda g_{\\mu\\nu}=\\frac{8\\pi G}{c^4}T_{\\mu\\nu}"}
{"cat":"realistic","display":true,"id":"stirling","src":"n! tilde.op sqrt(2 pi n) (n/e)^n","tex":"n! \\sim \\sqrt{2\\pi n}\\left(\\frac{n}{e}\\right)^n"}
