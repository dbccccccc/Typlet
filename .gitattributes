# Auto detect text files, store them with LF line endings, and check them out
# with LF on every platform too, as .editorconfig asks. Some tests read files
# such as fonts/typlet.css and expect LF.
* text=auto eol=lf

# Fixtures and corpus files are compared byte for byte by
# `npm run fixtures:check`, so keep LF line endings on every platform.
*.jsonl text eol=lf

*.woff2 binary

# Generated files: collapsed in diffs on GitHub, and left out of its language
# statistics. `npm run codegen`, `npm run fixtures` and `npm run docs:features`
# write them.
src/generated/** linguist-generated
test/fixtures/** linguist-generated
docs/supported.md linguist-generated
package-lock.json linguist-generated
